# ==============================================================================
# WallpaperMaison - Configuration active (.env)
# ==============================================================================

# URL directe du fond d'écran vidéo (MP4, WebM) ou image statique
wallpaperlink=""

# Intervalle de vérification en secondes pour vérifier les mises à jour (défaut : 30)
check_interval=30

ROTATION_ENABLED=true
ROTATION_INTERVAL_MINUTES=1
ROTATION_FOLDER="Wallpaper"
ROTATION_ORDER=random
