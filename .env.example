# ==============================================================================
# WallpaperMaison - Configuration d'environnement (.env.example)
# ==============================================================================

# URL directe du fond d'écran vidéo (MP4, WebM) ou image statique
# Si renseigné, WallpaperMaison télécharge et synchronise automatiquement ce fond d'écran.
wallpaperlink="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4"

# Intervalle de vérification en secondes pour retélécharger / synchroniser (défaut : 30)
check_interval=30

# ==============================================================================
# Rotation automatique des fonds d'écran (Diaporama)
# ==============================================================================
# Activer ou désactiver la rotation automatique (true / false)
ROTATION_ENABLED=false

# Intervalle de rotation en minutes (ex: 1, 5, 10, 15, 30, 60)
ROTATION_INTERVAL_MINUTES=5

# Répertoire source contenant les fonds d'écran (Vidéos MP4/WebM ou Images PNG/JPG)
# Peut être un chemin relatif au projet (ex: "Wallpaper") ou absolu (ex: "/home/user/Pictures/Wallpapers")
ROTATION_FOLDER="Wallpaper"

# Ordre de sélection : "random" (aléatoire) ou "sequential" (dans l'ordre)
ROTATION_ORDER="random"
