#!/bin/bash
TARGET_DIR="${PWD:-$HOME}"

USE_SYSTEMD=0
if [ -f /proc/self/uid_map ] && ! grep -q "4294967295" /proc/self/uid_map && command -v systemd-run >/dev/null 2>&1; then
    USE_SYSTEMD=1
fi

RUNNER=()
if [ "$USE_SYSTEMD" = "1" ]; then
    if [ -t 0 ] && [ -t 1 ]; then
        RUNNER=(systemd-run --user --pty --quiet)
    else
        RUNNER=(systemd-run --user --pipe --wait --quiet)
    fi
fi

if [ -t 0 ] && [ -t 1 ]; then
    PODMAN_TTY=(-it)
else
    PODMAN_TTY=(-i)
fi

exec "${RUNNER[@]}" podman run "${PODMAN_TTY[@]}" --rm --privileged --uts=host -v /:/host alpine chroot /host /usr/bin/env \
    HOME="$HOME" \
    LANG="${LANG:-fr_FR.UTF-8}" \
    LC_ALL="${LC_ALL:-fr_FR.UTF-8}" \
    TERM="${TERM:-xterm-256color}" \
    PATH="$HOME/.local/bin:$HOME/reseau/Perso/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    /usr/bin/bash -c '
cd "$1" 2>/dev/null || cd /
shift
sudo() {
    while [ $# -gt 0 ]; do
        case "$1" in
            -i|-s) shift; if [ $# -eq 0 ]; then return 0; fi ;;
            -u|-g|-p|-C|-c|-T) shift 2 ;;
            -E|-b|-H|-k|-K|-n|-S|-v) shift ;;
            --) shift; break ;;
            -*) shift ;;
            *) break ;;
        esac
    done
    if [ $# -eq 0 ]; then return 0; fi
    "$@"
}
export -f sudo 2>/dev/null

if [ $# -eq 0 ]; then
    echo -e "\033[01;31m========================================================================\033[00m"
    echo -e "\033[01;37m⚡ SESSION ROOT ADMINISTRATEUR (PODMAN PRIVILÉGIÉ & CHROOT HÔTE)\033[00m"
    echo -e "\033[01;31m========================================================================\033[00m"
    echo -e " • \033[01;32mPrivilèges :\033[00m UID 0 (root) - commandes root et sudo sans mot de passe"
    echo -e " • \033[01;32mSystème hôte :\033[00m Racine / de la machine montée en chroot direct"
    echo -e " • \033[01;33mSécurité Noyau Linux (DAC) :\033[00m"
    echo -e "   Les dossiers privés en mode 0700 des autres comptes hôtes"
    echo -e "   (ex: \033[01;34m/var/home/adminiut\033[00m) restent protégés par le noyau hôte."
    echo -e " • \033[01;36mConseil :\033[00m 'adminiut' est un DOSSIER et non un fichier (utilisez 'ls')."
    echo -e "\033[01;31m========================================================================\033[00m"
    export PS1="\[\033[01;31m\]⚡ root@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# "
    exec /usr/bin/bash --norc -i
elif [[ "$1" == -* ]]; then
    exec /usr/bin/bash "$@"
else
    exec "$@"
fi' bash "$TARGET_DIR" "$@"
